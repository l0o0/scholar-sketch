{
  "name": "scholarsketch",
  "type": "module",
  "version": "0.2.23",
  "description": "Markdown & Whiteboard for Zotero — edit Markdown files and connect literature, notes, and ideas on a visual canvas.",
  "config": {
    "addonName": "Scholar Sketch",
    "addonID": "bamboo@@linxzh.com",
    "addonRef": "bamboo",
    "addonInstance": "ScholarSketch",
    "prefsPrefix": "extensions.zotero.bamboo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l0o0/scholar-sketch.git"
  },
  "author": "l0o0",
  "bugs": {
    "url": "https://github.com/l0o0/scholar-sketch/issues"
  },
  "homepage": "https://github.com/l0o0/scholar-sketch#readme",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "tsc -p packages/fake-zotero/tsconfig.json && zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "node scripts/release-promote.mjs",
    "test": "zotero-plugin test",
    "whiteboard:dev": "pnpm --filter @zotero-markdown/whiteboard dev",
    "whiteboard:build": "pnpm --filter @zotero-markdown/whiteboard build",
    "test:prepare": "pnpm --filter @zotero-plugin/fake-zotero build",
    "test:fake-zotero": "pnpm run test:prepare && node scripts/test-runner.mjs fake",
    "test:unit": "pnpm run test:prepare && node scripts/test-runner.mjs unit",
    "update-deps": "pnpm update --save",
    "test:suites:check": "node scripts/check-test-suites.mjs",
    "verify": "pnpm run test:suites:check && pnpm run lint:check && pnpm run test:unit && pnpm run test:fake-zotero && pnpm run build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "@mdit/plugin-footnote": "^1.1.2",
    "@mdit/plugin-katex": "^1.1.3",
    "@xyflow/react": "^12.12.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "mermaid": "11.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zotero-plugin-toolkit": "6.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "@zotero-plugin/fake-zotero": "workspace:*",
    "chai": "^6.3.0",
    "eslint": "^10.13.0",
    "happy-dom": "^20.14.5",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "pnpm": {
    "blockExoticSubdeps": false,
    "patchedDependencies": {
      "@lezer/markdown@1.7.2": "patches/@lezer__markdown@1.7.2.patch"
    }
  }
}
